# Copy to `.env` in this folder (never commit `.env`).
#
# Required for deploy / contract txs on `somniaTestnet`:
HACKATHON_KEY=0xYOUR_64_HEX_CHARS

# Optional — if https://api.infra.testnet.somnia.network times out (ETIMEDOUT):
# SOMNIA_RPC_URL=https://dream-rpc.somnia.network

# Optional — only for `npx hardhat ignition deploy --verify` or verify tasks:
# SOMNIA_EXPLORER_API_KEY=
