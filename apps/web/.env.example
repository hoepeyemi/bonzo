# Reown AppKit — required for wallet connect (https://cloud.reown.com/)
# Do not use the placeholder below; create a project and paste your real project ID.
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# App URL (optional - auto-detected from request if not set)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# x402 — set your facilitator base URL (must understand network id `somnia-testnet` in payloads)
NEXT_PUBLIC_X402_FACILITATOR_URL=https://your-facilitator.example/v2/x402
# Target EVM chain (Somnia Shannon testnet)
NEXT_PUBLIC_CHAIN_ID=50312

# Optional: RPC for .cro registry reads (chain 25); overrides bundled default
# NEXT_PUBLIC_DOT_CRO_REGISTRY_RPC_URL=https://...

# Optional: override Somnia testnet STT (EIP-3009) payment token address
# NEXT_PUBLIC_USDCE_ADDRESS=0x...

# Somnia Agents — https://agents.testnet.somnia.network
# Deploy: JSON_API_AGENT_ID=<id> npx hardhat run scripts/deploy-somnia-agent-bridge.ts --network somniaTestnet
# NEXT_PUBLIC_SOMNIA_AGENT_BRIDGE_ADDRESS=0x...
# NEXT_PUBLIC_JSON_API_AGENT_ID=

# Server-side Somnia oracle runner (POST /api/somnia/labeled-fetch); needs native STT
# SOMNIA_ORACLE_EXECUTOR_KEY=0x...
# SOMNIA_ORACLE_POLL_TIMEOUT_MS=300000
# Database
DATABASE_URL=postgresql://postgres:dev_password@localhost:5432/x402_marketplace

# Redis (for session nonces and caching) — required in production
# Local: docker run --name x402-redis -p 6379:6379 -d redis:7
REDIS_URL=redis://localhost:6379
# Optional dev fallback if Redis is down (in-memory only, single process):
# NONCE_STORE=memory

# Session (generate with: openssl rand -base64 32)
SESSION_SECRET=your-32-character-secret-key-here

# Server RSA Keys for header encryption (generate with: pnpm generate-keys)
# Keys are in PEM format - use \n for newlines in env vars
SERVER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
SERVER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# MCP Server (for OAuth metadata - where clients connect for MCP traffic)
MCP_PUBLIC_URL=https://mcp.yourdomain.com
NEXT_PUBLIC_MCP_URL=https://mcp.yourdomain.com

# Payment recipient address (optional - defaults to facilitator fee recipient)
# PAYMENT_RECIPIENT_ADDRESS=0x...

# Relayer key for gasless transactions (optional - only needed if running your own relayer)
# FACILITATOR_RELAYER_KEY=0x...

# Fee configuration (optional - has sensible defaults)
# FACILITATOR_FEE_BPS=50           # 0.5% fee
# FACILITATOR_MIN_FEE=100          # 0.0001 STT minimum
# FACILITATOR_MAX_FEE=10000        # 0.01 STT maximum
# FACILITATOR_FEE_RECIPIENT=0x...
